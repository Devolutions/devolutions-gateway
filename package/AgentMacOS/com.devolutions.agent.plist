<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.devolutions.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/devolutions-agent</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/microsoft/powershell/7:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ExitTimeOut</key>
	<integer>45</integer>
	<key>StandardOutPath</key>
	<string>/Library/Logs/Devolutions Agent/agent.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/Devolutions Agent/agent.stderr.log</string>
</dict>
</plist>
